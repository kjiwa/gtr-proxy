{
  "name": "gtr-proxy",
  "version": "3.0.0",
  "description": "Cloudflare Worker that lets a browser copy Google Takeout archives to Azure Blob Storage server side, using an encrypted, expiring ticket instead of plaintext cookies.",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjiwa/gtr-proxy.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "GTR_SECRET": {
        "description": "Shared secret for the GTR extension. Generate with: openssl rand -base64 32 | tr \"+/\" \"-_\" | tr -d \"=\". Paste the same value into the extension settings."
      }
    }
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
